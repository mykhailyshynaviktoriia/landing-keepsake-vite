{
  "name": "vite-pug-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "images": "node scripts/images.mjs",
    "lint:style": "stylelint \"src/**/*.scss\"",
    "format": "prettier --write \"src/**/*.{scss,js,css,html,json}\"",
    "format:check": "prettier --check \"src/**/*.{scss,js,css,html,json}\"",
    "prepare": "husky"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Edge versions",
    "last 2 Safari versions",
    "last 2 iOS versions",
    "iOS >= 12"
  ],
  "devDependencies": {
    "@vituum/vite-plugin-pug": "^1.1.0",
    "autoprefixer": "^10.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "sass": "^1",
    "sharp": "^0.35.5",
    "stylelint": "^18.1.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "vite": "^5.4.21",
    "vituum": "^1.2.0"
  },
  "lint-staged": {
    "*.scss": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{js,css,html,json}": [
      "prettier --write"
    ]
  }
}
